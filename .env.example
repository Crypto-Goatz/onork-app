# 0nCore env example — non-secret reference for required vars.
# Real values live on Vercel (per env-var rule: PIT/Bearer = type:plain, secrets = type:encrypted).

# Spectra Assure (secure.software / ReversingLabs) — software supply chain
# Used by the HIPAA scanner to add 6 supply-chain checks to Tier 4 reports.
# Get a Personal Access Token at https://my.secure.software → Settings → API
SPECTRA_ASSURE_TOKEN=
SPECTRA_ASSURE_HOST=https://my.secure.software
SPECTRA_ASSURE_GROUP=rocketopp
SPECTRA_ASSURE_PROJECT=hipaa-scanner

# ── Marketplace app credentials (0nCORE dashboard) ──────────────────────────
# TWO apps, split by token type — the platform divides agency and sub-account
# capability and there is no single app that spans both.
#
#   Sub-Account app — per-location work (contacts, conversations, calendars,
#   opportunities, medias). Mints location tokens via oauth.write.
CRM_SUBACCT_CLIENT_ID=
CRM_SUBACCT_CLIENT_SECRET=
#
#   Agency app — locations.write (create sub-account WITH snapshotId),
#   snapshots.*, companies.readonly, saas/company.*. Agency token only.
CRM_AGENCY_CLIENT_ID=
CRM_AGENCY_CLIENT_SECRET=
#
# SSO shared secret — decrypts the Custom Page user context, SERVER SIDE ONLY.
# This must never reach the browser; it is the whole basis of trusting who is
# looking at the iframe.
CRM_SSO_KEY=
#
# Signs our own short-lived app session token (lib/auth/app-jwt.ts).
APP_JWT_SECRET=

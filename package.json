{
  "name": "onork-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-content-lastmod.mjs && node scripts/pre-deploy.mjs && TRUTH_LINT_STRICT=1 node scripts/truth-lint.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "truth-lint": "node scripts/truth-lint.mjs",
    "truth-lint:strict": "TRUTH_LINT_STRICT=1 node scripts/truth-lint.mjs",
    "dev:local": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=$(supabase status -o env 2>/dev/null | grep ANON_KEY | cut -d= -f2 | tr -d \"\"\") next dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:snapshot": "supabase db dump --linked -f /tmp/production_snapshot_$(date +%s).sql",
    "db:restore-local": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres < /tmp/production_snapshot_*.sql 2>/dev/null | tail -5",
    "test:e2e": "playwright test --grep @smoke",
    "test:e2e:cleanup": "tsx tests/e2e/cleanup.ts",
    "test:jwt": "tsx scripts/test/app-jwt.test.ts",
    "lastmod": "node scripts/gen-content-lastmod.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@base-ui/react": "^1.4.0",
    "@gohighlevel/api-client": "^2.2.2",
    "@google/genai": "^1.47.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.10.2",
    "0nmcp": "^4.10.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.14.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email-editor": "^1.8.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.0"
  }
}
